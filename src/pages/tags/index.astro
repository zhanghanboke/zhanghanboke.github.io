---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { collectTags } from '../../utils/post';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const tags = collectTags(posts);
---

<BaseLayout title="标签" description={`共 ${tags.length} 个标签。`}>
  <div class="container">
    <div class="page-head">
      <h1 class="page-title">标签</h1>
      <p class="page-desc">
        <Icon name="tag" size={14} /> 共 {tags.length} 个标签
      </p>
    </div>

    {
      tags.length > 0 ? (
        <div class="tag-cloud">
          {tags.map((tag) => (
            <a class="tag-cloud-item" href={`/tags/${encodeURIComponent(tag.name)}/`}>
              #{tag.name}
              <span class="tag-count">{tag.count}</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty">
          <p class="empty-title">还没有标签</p>
          <p>在文章的 frontmatter 里写 tags: [标签1, 标签2] 就会出现。</p>
        </div>
      )
    }
  </div>
</BaseLayout>
