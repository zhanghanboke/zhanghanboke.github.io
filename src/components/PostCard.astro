---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatDate, getExcerpt, readingTime, wordCount } from '../utils/post';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, tags = [], description, cover } = post.data;

const excerpt = description || getExcerpt(post.body, 108);
const minutes = readingTime(post.body);
const words = wordCount(post.body);
---

<article class="post-card">
  <div class="post-card-body">
    {
      tags.length > 0 && (
        <div class="post-card-tags">
          {tags.slice(0, 4).map((tag) => (
            <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
              #{tag}
            </a>
          ))}
        </div>
      )
    }

    <h3 class="post-card-title">
      <a href={`/posts/${post.id}/`}>{title}</a>
    </h3>

    {excerpt && <p class="post-card-excerpt">{excerpt}</p>}

    <div class="post-card-meta">
      <span class="meta-item">
        <Icon name="calendar" size={12.5} />
        {formatDate(date)}
      </span>
      <span class="meta-dot"></span>
      <span class="meta-item">
        <Icon name="clock" size={12.5} />
        {minutes} 分钟
      </span>
      <span class="meta-dot"></span>
      <span class="meta-item">
        <Icon name="file" size={12.5} />
        {words} 字
      </span>
    </div>
  </div>

  {
    cover && (
      <img
        class="post-card-cover"
        src={cover}
        alt=""
        loading="lazy"
        width="178"
        height="104"
      />
    )
  }
</article>
