---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatDate, getExcerpt, readingTime } from '../utils/post';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, tags = [], description } = post.data;

const excerpt = description || getExcerpt(post.body, 108);
const minutes = readingTime(post.body);
---

<article class="post-card">
  <h3 class="post-card-title">
    <a href={`/posts/${post.id}/`}>{title}</a>
  </h3>

  {excerpt && <p class="post-card-excerpt">{excerpt}</p>}

  <div class="post-card-meta">
    <span class="meta-item">
      <Icon name="calendar" size={13} />
      {formatDate(date)}
    </span>
    <span class="meta-item">
      <Icon name="clock" size={13} />
      {minutes} 分钟
    </span>
  </div>

  {
    tags.length > 0 && (
      <div class="post-card-tags" style="margin-top: 12px">
        {tags.map((tag) => (
          <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
            #{tag}
          </a>
        ))}
      </div>
    )
  }
</article>
